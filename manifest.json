{
  "manifest_version": 3,
  "name": "Cumpleaños para Google Calendar",
  "short_name": "Cumpleaños",
  "version": "1.2.0",
  "description": "Agregá cumpleaños a Google Calendar como eventos anuales con recordatorios, en dos clics.",
  "homepage_url": "https://github.com/smalirat/birthdays-alarms",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Agregar cumpleaños",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://calendar.google.com/*"],
      "js": ["calendar-button.js"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["popup.html", "icons/icon48.png"],
      "matches": ["https://calendar.google.com/*"]
    }
  ],
  "permissions": ["identity", "storage"],
  "host_permissions": ["https://www.googleapis.com/*"],
  "oauth2": {
    "client_id": "2722130457-9t21i92u2psptpc4lgi7b4p1qsodmdmj.apps.googleusercontent.com",
    "scopes": ["https://www.googleapis.com/auth/calendar.events"]
  }
}
